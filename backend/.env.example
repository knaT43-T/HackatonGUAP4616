# Скопируй в .env и правь под себя. Все значения ниже — умолчания приложения.

# --- Сервер ---
HOST=0.0.0.0
PORT=8000
RELOAD=true

# --- Сессия (cookie) ---
COOKIE_NAME=pid
SESSION_TTL_DAYS=30
NICKNAME_MAX_LEN=32

# --- CORS. ВАЖНО: список в JSON-массиве, без кавычек-одиночных.
#     allow_credentials=True несовместим с "*", так что origin'ы надо перечислить.
#     Сюда впиши адрес фронтенда.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]

# --- Файлы треков ---
# catalog/ — сами mp3 (раздаётся на /media), data/ — служебный tracks.json
CATALOG_DIR=catalog
DATA_DIR=data
UPLOAD_MAX_MB=50

# --- Комнаты ---
ROOM_IDLE_TTL_MIN=30
TICKER_INTERVAL_MS=1000
BROADCAST_TIMEOUT_S=5.0