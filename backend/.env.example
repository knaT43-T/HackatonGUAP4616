# Скопируй этот файл в backend/.env:  cp backend/.env.example backend/.env
# Все значения ниже — дефолтные, можно ничего не менять для локального запуска.

HOST=0.0.0.0
PORT=8000
RELOAD=true

COOKIE_NAME=pid
# Для https-деплоя поставь true — cookie будет отдаваться только по HTTPS
COOKIE_SECURE=false
SESSION_TTL_DAYS=30
NICKNAME_MAX_LEN=32
ROOM_NAME_MAX_LEN=60

CORS_ORIGINS=["http://localhost", "http://localhost:5173", "http://127.0.0.1:5173"]

CATALOG_DIR=catalog
DATA_DIR=data
UPLOAD_MAX_MB=50

ROOM_IDLE_TTL_MIN=30
TICKER_INTERVAL_MS=1000
BROADCAST_TIMEOUT_S=5.0

# Логи
# DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
# false — полностью выключить access-лог (запросы в лог не пишутся)
ACCESS_LOG=true
